{
  "name": "conference-host-app",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "boundaries": "turbo boundaries",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "deps": "node scripts/dependencies.mjs",
    "deps:check": "node scripts/dependencies.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs .claude/skills/verify-host-app/scripts/*.test.mjs",
    "ties": "node scripts/claude-ties.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "ui/apps/*",
    "contracts",
    "backend",
    "data/store",
    "conference-api-contract",
    "tooling/*"
  ]
}
