{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": [
    "//"
  ],
  "tags": [
    "host-backend"
  ],
  "tasks": {
    "test": {
      "env": [
        "HOST_BACKEND_TEST_DATABASE_URL"
      ]
    },
    "sync": {
      "cache": false
    },
    "verify:sends": {
      "cache": false,
      "passThroughEnv": [
        "JAVA_HOME",
        "JAVA_TOOL_OPTIONS",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
