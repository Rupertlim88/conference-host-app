{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "askers": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$"
      }
    },
    "talks": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$"
      }
    }
  },
  "required": [
    "conference",
    "askers",
    "talks"
  ],
  "additionalProperties": false
}
