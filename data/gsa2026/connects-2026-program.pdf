            xmlns:ExtensisFontSense="http://www.extensis.com/meta/FontSense/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2027 GSA Calendar </rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Earth's Tableaux&#xD;Celebrating Earth as nature‚Äôs canvas, GSA‚Äôs calendar presents a stunning tableaux of landscapes and geologic wonders to enjoy each month. This 12-month calendar includes awe-inspiring images: &#xD;The longest glacier in the Eastern Alps, Austria&#xD;Marshlands of North Carolina, USA&#xD;Jurassic-age, knifelike spires of limestone in Madagascar&#xD;And more!&#xD;Special features: &#xD;Dates of geoscience events and programs&#xD;Birthdates of famous geoscientists&#xD;Dates of many noteworthy eruptions &amp; earthquakes&#xD;CAL2027, $9.95 </rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreateDate>2026-08-21T11:30:26-06:00</xmp:CreateDate>
