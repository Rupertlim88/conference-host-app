{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Recommendation",
  "$defs": {
    "Recommendation": {
      "type": "object",
      "properties": {
        "for_talk_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidate_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "match": {
          "type": "boolean"
        },
        "cross_domain": {
          "type": "boolean"
        },
        "shared": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "intent",
              "technique"
            ]
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
        },
        "methods": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "this": {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  },
                  "technique": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  }
                },
                "required": [
                  "intent",
                  "technique"
                ],
                "additionalProperties": false
              },
              "other": {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  },
                  "technique": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  }
                },
                "required": [
                  "intent",
                  "technique"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "this",
              "other"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "engine_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "for_talk_id",
        "candidate_id",
        "score",
        "rank",
        "match",
        "cross_domain",
        "shared",
        "description",
        "methods",
        "evidence",
        "engine_id",
        "run_id",
        "contract_version"
      ],
      "additionalProperties": false,
      "title": "Recommendation"
    }
  }
}
