{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]{22}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "partner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "organiser": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "partner",
        "organiser"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "talks": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "x-data-kind": "programme"
              },
              "number": {
                "x-data-kind": "programme",
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
                "x-data-kind": "programme"
              },
              "abstract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
                "x-data-kind": "programme"
              },
              "type": {
                "x-data-kind": "programme",
                "type": "string",
                "enum": [
                  "oral",
                  "poster",
                  "invited",
                  "keynote",
                  "panel",
                  "other"
                ]
              },
              "keywords": {
                "x-data-kind": "programme",
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                }
              },
              "tracks": {
                "x-data-kind": "programme",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                }
              },
              "session": {
                "x-data-kind": "programme",
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "x-data-kind": "programme"
                  },
                  "title": {
                    "x-data-kind": "programme",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  },
                  "type": {
                    "x-data-kind": "programme",
                    "type": "string",
                    "enum": [
                      "oral",
                      "poster",
                      "invited",
                      "other"
                    ]
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "start": {
                "x-data-kind": "programme",
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "end": {
                "x-data-kind": "programme",
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "language": {
                "x-data-kind": "programme",
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "authors": {
                "x-data-kind": "pii",
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "x-data-kind": "pii"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
                      "x-data-kind": "pii"
                    },
                    "orcid": {
                      "x-data-kind": "pii",
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "presenters": {
                "x-data-kind": "pii",
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "status": {
                "x-data-kind": "programme",
                "type": "string",
                "enum": [
                  "scheduled",
                  "withdrawn",
                  "cancelled"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "abstract"
            ],
            "additionalProperties": false
          },
          "x-data-kind": "pii"
        },
        "withdraw": {
          "x-data-kind": "programme",
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "sync": {
          "x-data-kind": "operational",
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,100}$"
        },
        "complete": {
          "x-data-kind": "operational",
          "type": "boolean"
        }
      },
      "required": [
        "talks"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "complete": [
          "sync"
        ]
      }
    }
  },
  "required": [
    "requestId",
    "actor",
    "request"
  ],
  "additionalProperties": false
}
