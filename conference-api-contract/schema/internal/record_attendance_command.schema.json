{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "partner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "organiser": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "partner",
        "organiser"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "signatureInput": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha-256=:[A-Za-z0-9+/]{43}=:$"
        }
      },
      "required": [
        "keyId",
        "signatureInput",
        "signature",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "corrects": {
      "type": "string",
      "pattern": "^att_[A-Za-z0-9_-]{22}$"
    },
    "newKeys": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 40,
        "maxLength": 2000,
        "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    },
    "lines": {
      "minItems": 1,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "orcid": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "attended": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "person",
          "name",
          "attended"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reportId",
    "actor",
    "signature",
    "newKeys",
    "lines"
  ],
  "additionalProperties": false
}
