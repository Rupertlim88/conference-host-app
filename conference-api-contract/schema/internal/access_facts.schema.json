{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "partnerKind": {
      "type": "string",
      "enum": [
        "organiser",
        "provider"
      ]
    },
    "organiser": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "granted": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "talks:write",
          "matches:read",
          "settings:write",
          "attendance:write",
          "credentials:issue",
          "people:erase",
          "agreements:read",
          "agreements:write"
        ]
      }
    },
    "agreed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "talks:write",
          "matches:read",
          "attendance:write",
          "credentials:issue"
        ]
      }
    }
  },
  "required": [
    "partnerKind",
    "organiser",
    "granted",
    "agreed"
  ],
  "additionalProperties": false
}
