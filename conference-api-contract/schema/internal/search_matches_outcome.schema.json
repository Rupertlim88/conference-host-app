{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "matches": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "person": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "basedOn": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "talk": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "core",
                      "unexpected"
                    ]
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "match": {
                    "type": "boolean"
                  },
                  "shared": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "intent",
                        "technique"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                  },
                  "methods": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "this": {
                          "type": "object",
                          "properties": {
                            "intent": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                            },
                            "technique": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                            }
                          },
                          "required": [
                            "intent",
                            "technique"
                          ],
                          "additionalProperties": false
                        },
                        "other": {
                          "type": "object",
                          "properties": {
                            "intent": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                            },
                            "technique": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
                            }
                          },
                          "required": [
                            "intent",
                            "technique"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "this",
                        "other"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "programmeVersion": {
                    "type": "string",
                    "pattern": "^pv_[A-Za-z0-9_-]{22}$"
                  }
                },
                "required": [
                  "basedOn",
                  "talk",
                  "kind",
                  "rank",
                  "score",
                  "match",
                  "shared",
                  "description",
                  "methods",
                  "programmeVersion"
                ],
                "additionalProperties": false
              }
            },
            "nextPageToken": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            }
          },
          "required": [
            "matches"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "problem": {
          "type": "string",
          "const": "page-token-invalid"
        }
      },
      "required": [
        "ok",
        "problem"
      ],
      "additionalProperties": false
    }
  ]
}
