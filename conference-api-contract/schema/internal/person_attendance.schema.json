{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "unknown": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "unknown"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "erased": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "erased"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "wrappedKey": {
          "type": "string",
          "minLength": 40,
          "maxLength": 2000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "line": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 40,
              "maxLength": 2000,
              "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "orcid": {
              "type": "string",
              "minLength": 40,
              "maxLength": 2000,
              "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "attended": {
              "type": "string",
              "minLength": 40,
              "maxLength": 2000,
              "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "name",
            "attended"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "wrappedKey",
        "line"
      ],
      "additionalProperties": false
    }
  ]
}
