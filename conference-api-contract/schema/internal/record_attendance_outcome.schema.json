{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^att_[A-Za-z0-9_-]{22}$",
              "x-data-kind": "operational"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "x-data-kind": "operational"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "x-data-kind": "operational"
            },
            "attendees": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "x-data-kind": "operational"
            },
            "corrects": {
              "x-data-kind": "operational",
              "type": "string",
              "pattern": "^att_[A-Za-z0-9_-]{22}$"
            }
          },
          "required": [
            "entry",
            "sequence",
            "recordedAt",
            "attendees"
          ],
          "additionalProperties": false
        },
        "hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "stamped": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "result",
        "hash",
        "stamped"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "talk": {
                "x-data-kind": "programme",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
                "x-data-kind": "operational"
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
                "x-data-kind": "pii"
              }
            },
            "required": [
              "field",
              "problem"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "errors"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "keysChanged": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "ok",
        "keysChanged"
      ],
      "additionalProperties": false
    }
  ]
}
