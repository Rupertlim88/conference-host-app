{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "wrappedKey": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "wrappedKey"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "erased": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "erased"
        ],
        "additionalProperties": false
      }
    ]
  }
}
