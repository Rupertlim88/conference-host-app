{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "engine": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "request": {
      "type": "object",
      "properties": {
        "title": {
          "x-data-kind": "programme",
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\uFEFF]*$",
          "x-data-kind": "programme"
        },
        "kind": {
          "x-data-kind": "operational",
          "type": "string",
          "enum": [
            "core",
            "unexpected"
          ]
        },
        "minScore": {
          "x-data-kind": "operational",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "x-data-kind": "operational",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "engine",
    "request"
  ],
  "additionalProperties": false
}
