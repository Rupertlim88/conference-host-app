{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conferences": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
      }
    }
  },
  "required": [
    "conferences"
  ],
  "additionalProperties": false
}
