{
  "openapi": "3.1.1",
  "info": {
    "title": "Conference API",
    "version": "1.0.0",
    "description": "Matching for conferences. Only partners' servers call it, each request with the API key for its conference."
  },
  "security": [
    {
      "partnerKey": []
    }
  ],
  "x-protections": {
    "requestsPerMinutePerAddress": 1200,
    "failedKeyChecksPerMinutePerAddress": 20
  },
  "x-versioning": {
    "noticeMonths": 6,
    "policy": "A change that would break partners becomes a new version under a new path prefix, running alongside the old one. A retiring operation is marked deprecated here, and its answers carry Deprecation and Sunset headers and a link to its successor. It keeps every security fix until it is switched off."
  },
  "x-business-limits": {
    "talksPerConference": 50000,
    "keptTalkRevisionsPerConference": 2000000,
    "programmeVersionsPerConference": 200000
  },
  "paths": {
    "/v1/conferences/{conference}/talks:write": {
      "post": {
        "operationId": "writeTalks",
        "summary": "Send one talk, several, or the whole programme. All or nothing.",
        "x-limits": {
          "maxBodyBytes": 10000000,
          "requestsPerMinute": 60,
          "requestsPerDay": 10000,
          "concurrentRequests": 2,
          "timeoutSeconds": 25
        },
        "security": [
          {
            "partnerKey": []
          }
        ],
        "parameters": [
          {
            "name": "conference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TalksWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TalksWriteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request breaks the specification; nothing was applied. Do not retry unchanged.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key: the Authorization header must carry this conference's live key, as Bearer <key>.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such conference for this key. Asking for any conference but the key's own gets this same answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The conference holds as much as it may: nothing was applied. The business limits are in x-business-limits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The request body is larger than this request allows.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON in UTF-8, uncompressed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: per minute, per day or at once for this key, from this network address, or failed key checks from this address. Retry after the time in Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error. Safe to retry: sending the same request again gives the same result.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The API cannot answer in time just now. Safe to retry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
