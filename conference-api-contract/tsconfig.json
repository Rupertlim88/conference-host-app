{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // The host apps' bundler reads this package as raw TypeScript and cannot map ".js" imports to ".ts" files,
    // so imports stay extensionless and resolution is Bundler, not NodeNext.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
