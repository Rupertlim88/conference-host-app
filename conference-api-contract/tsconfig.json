{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Bundler resolution, not NodeNext: the host apps (Turbopack) consume this package as raw TS
    // and cannot resolve ".js"-suffixed imports to .ts files. Keep relative imports extensionless.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
